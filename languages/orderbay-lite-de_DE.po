#. Plugin Name of the plugin
#: orderbay-lite.php includes/class-oblt-plugin.php:110
msgid "OrderBay Lite"
msgstr "OrderBay Lite"

#. Plugin URI of the plugin
#: orderbay-lite.php
msgid "https://tillpress.com/orderbay/"
msgstr "https://tillpress.com/orderbay/"

#. Description of the plugin
#: orderbay-lite.php
msgid ""
"Free WooCommerce invoices: PDF invoices attached to order emails, printable "
"invoices, sequential invoice numbers, credit notes, customer My Account PDF "
"download, and UBL 2.1 / Factur-X CII e-invoice XML export."
msgstr ""
"Kostenlose WooCommerce-Rechnungen: PDF-Rechnungen als Anhang von Bestell-E-"
"Mails, druckbare Rechnungen, fortlaufende Rechnungsnummern, "
"Rechnungskorrekturen, PDF-Download im Kundenkonto „Mein Konto“ sowie Export "
"von E-Rechnungs-XML (UBL 2.1 / Factur-X CII)."

